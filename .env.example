# ── LeChonk bot config (example) ─────────────────────────────────────
# Copy to .env and fill in your own values.

# Bot token from @BotFather (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=

# OpenAI-compatible API (examples: Mistral / OpenAI / OpenRouter)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.mistral.ai/v1
MODEL=mistral-large-4

# Model for requests that include images (empty = use MODEL)
VISION_MODEL=

# The owner's Telegram user id (the only one who gets the admin commands)
OWNER_ID=

# Base context window size (10–50; the window grows to 2×, then trims back)
CONTEXT_MESSAGES=25
# Max images from the context per request
MAX_IMAGES=4

# Wake words without an @mention (comma-separated, case-insensitive)
WAKE_WORDS=лечонк,lechonk

# Allowlist (Telegram user ids, comma-separated), besides the owner.
# The owner is always allowed. Empty = owner only. Editable at runtime: /allow, /deny.
ALLOWED_USERS=
# Invites by @username (no @, comma-separated) — access turns on at first contact
ALLOWED_USERNAMES=

# Require allowlisted non-owners to bring their own Mistral key (/setkey in DM)
REQUIRE_USER_KEYS=true

# Encrypt data/access.json (allowlist + users' API keys) at rest, AES-256-GCM.
# The value is a 32-byte key as 64 hex chars — generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Empty = the file stays plaintext; a legacy plaintext file is migrated on first load.
ENCRYPTION_KEY=

# Generation limits
MAX_TOKENS=3072
TEMPERATURE=0.4

# System prompt (empty = LeChonk's built-in prompt)
SYSTEM_PROMPT=

# Telegram Stars packs: stars = number of requests (e.g. 20,50,100)
STAR_PACKAGES=20,50,100
# Support contact for /support and /paysupport (empty = "bot owner")
SUPPORT_CONTACT=

# In a group, a stranger without access gets a short canned reply (no LLM):
# personal key (/setkey) or a pack (/buy). Cooldown — per (user, chat), in hours;
# cap — max such messages per chat per day (0 = disable the canned replies).
NOACCESS_OFFER_COOLDOWN_HOURS=12
NOACCESS_OFFER_CHAT_DAILY_CAP=3
